# =====================================================================
# CivicConnect Application Environment Configuration Template
# Standard: FEC-004 (Environment Parity) & DEC-005 (Docker/Local Parity)
# Instruction: Copy this file to '.env' and populate with local secrets.
# WARNING: NEVER commit actual '.env' files containing credentials to Git.
# =====================================================================

# --- Application Server ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# --- PostgreSQL Database (Local Docker & Staging) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=civicconnect_db
DB_USER=civic_admin
DB_PASSWORD=civic_dev_secret_2026
DATABASE_URL=postgresql://civic_admin:civic_dev_secret_2026@localhost:5432/civicconnect_db?schema=public

# --- pgAdmin Service (Optional Local UI) ---
PGADMIN_DEFAULT_EMAIL=admin@civicconnect.local
PGADMIN_DEFAULT_PASSWORD=admin_dev_pass_2026
PGADMIN_PORT=5050

# --- Authentication & JWT (POPIA Compliance / NFR-004) ---
JWT_SECRET=civicconnect_jwt_super_secret_key_2026_dev_min32chars
JWT_EXPIRES_IN=24h

# --- File Storage (Polyglot Attachments / FR-001) ---
# Supported drivers: 'local' | 's3' | 'mock'
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
MAX_FILE_SIZE_BYTES=10485760 # 10MB limit (NFR-007)

# --- Logging & Observability (FEC-005 / NFR-009) ---
LOG_LEVEL=debug
ENABLE_AUDIT_LOGGING=true
